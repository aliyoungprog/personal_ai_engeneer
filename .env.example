# --- Telegram ---
# Get from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (get from @userinfobot) — only this user can talk to the bot
TELEGRAM_ALLOWED_USER_ID=

# --- Notion ---
# Create internal integration: https://www.notion.so/profile/integrations
# Then share the Tasks database with this integration (•••  menu -> Connections -> add)
NOTION_TOKEN=
# Tasks data source ID (already configured; this is the new Notion API v2025+ concept,
# distinct from the database ID. For our 🔎 Tasks DB this is the single data source.)
NOTION_DATA_SOURCE_ID=386a87fe-ad92-4cee-8417-5e0694e2bff8
# Your full name as it appears in Notion (used to filter Assignee)
NOTION_ASSIGNEE_NAME=Abdurakhmanov Abduvali

# --- Notion filter ---
# Comma-separated Project values to include (must match Notion select options)
NOTION_PROJECT_WHITELIST=AI Platform,AI Assistant,AI CC
# Comma-separated Status values to include
NOTION_STATUS_WHITELIST=To Do,Triage

# --- GitLab (not used in Phase 0, but reserved) ---
GITLAB_URL=https://git.chocodev.kz
GITLAB_TOKEN=
GITLAB_PROJECT_PATH=freedom-ai/platform/ai-agents-platform

# --- Runtime ---
# Poll Notion every N seconds
POLL_INTERVAL_SECONDS=300
# SQLite path inside container
DATABASE_PATH=/app/data/state.db
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
